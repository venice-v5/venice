        Creates a new controller selected by `id`.

        `id` defaults to `ControllerId.PRIMARY`.

        # Raises

        - `ValueError`: If that controller ID is already in use by another `Controller` binding.
        """
        ...

    def read_state(self) -> ControllerState:
